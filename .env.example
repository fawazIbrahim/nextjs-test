# Base URLs of this app's two telemetry backends, reached directly over
# OTLP/HTTP — there is no collector in between. Used by the server-side
# OTLP exporters directly, and by src/app/otlp/[...path]/route.ts as the
# proxy target for browser telemetry. See design/DESIGN.md §4/§7.3.
TEMPO_URL=http://localhost:4318
MIMIR_URL=http://localhost:4318

# Same-origin path prefix the browser sends OTLP traces/metrics to.
# src/app/otlp/[...path]/route.ts forwards each request to TEMPO_URL or
# MIMIR_URL depending on the OTLP signal path, attaching the auth header
# described below.
OTLP_ENDPOINT=/otlp

# Set to "appid" to authenticate every export (server-side, and via the
# /otlp proxy) with an IBM Cloud App ID access token. Leave unset to send
# telemetry unauthenticated (e.g. against the mock OTLP receiver below).
# This is the single on/off switch for the whole App ID auth layer
# (src/otel/auth/) — see design/DESIGN.md §7.11.
TELEMETRY_AUTH_PROVIDER=appid

# Required only when TELEMETRY_AUTH_PROVIDER=appid — IBM Cloud App ID
# OAuth2 client-credentials grant. APPID_TOKEN_URL is your App ID tenant's
# token endpoint, e.g.
# https://<region>.appid.cloud.ibm.com/oauth/v4/<tenantId>/token
APPID_TOKEN_URL=
APPID_CLIENT_ID=
APPID_CLIENT_SECRET=

# Resource attributes attached to every span and metric this app emits
# (both server- and browser-side). All optional — defaults shown below.
OTEL_SERVICE_NAME=restaurant-menu-viewer
OTEL_SERVICE_VERSION=0.1.0
OTEL_DEPLOYMENT_ENVIRONMENT=development
